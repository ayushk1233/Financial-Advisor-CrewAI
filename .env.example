# .env.example for financial_health_advisor
# Copy this file to `.env` and fill in the values. Do NOT commit real secrets to git.

# Google Gemini API key (required for Gemini LLM usage)
GEMINI_API_KEY=

# Optional: Gemini model name (defaults to models/gemini-pro-latest in code)
GEMINI_MODEL=models/gemini-pro-latest

# Optional: logging level
LOG_LEVEL=INFO

# Add any other environment variables your deployment needs below, e.g.:
# DATABASE_URL=
# SENTRY_DSN=